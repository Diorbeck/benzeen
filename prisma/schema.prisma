// Fuelflow - B2B Fuel Delivery Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  DRIVER
  COURIER
  DISPATCHER
  CLIENT
  PROPANE_OPERATOR
  // v2: владелец стационарной АЗС. Видит только свои резервуары, колонки и
  // счёт; к заказам доставки доступа не имеет.
  STATION_OWNER
}

enum FuelType {
  AI_92
  AI_95
  AI_100
  PROPANE
  // v2: на стационарных АЗС есть 98-й и дизель, которых нет в доставке.
  // Добавлено в конец: порядок значений в PostgreSQL значим, а вставлять
  // значение в середину типа дороже и рискованнее, чем сортировать в коде.
  AI_98
  DIESEL
}

// B2C payment (M2). B2B orders leave these null (paymentStatus NOT_REQUIRED).
enum PaymentMethod {
  COURIER_POS
  PAYME
  CLICK
  UZUM
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
}

// Bonus liters ledger (M5). Balance = sum of non-SPENT liters − sum of SPENT.
// All rows store a positive `liters`; the reason decides the sign.
enum BonusReason {
  FRIEND_FIRST_ORDER      // +1 to referrer when a referred friend's 1st order is delivered
  TEN_FRIENDS_MILESTONE   // +10 to referrer at 10 referred friends
  SPENT                   // −N used on an order
  REFUND                  // +N returned when a bonus-using order is cancelled
  ADMIN_ADJUSTMENT        // +N manual correction by a super-admin (append-only, with a comment)
}

// Lifecycle of a ledger row (PR-C, bonus-program protection). Only POSTED rows
// count toward the balance AND the "10 friends" milestone. Rate-capped accruals
// land as PENDING and are Approved (→POSTED) or Rejected (→REJECTED) by an admin.
// This `status` is the ONLY field on an existing ledger row that may ever change.
enum BonusLedgerStatus {
  POSTED
  PENDING
  REJECTED
}

// Support tickets (Кабинет 2.0, PR-A). Client-submitted; admin triage is a later PR.
enum SupportTicketType {
  COMPLAINT
  SUGGESTION
  QUESTION
}

enum SupportTicketStatus {
  NEW // legacy (миграция: NEW → OPEN)
  RESOLVED // legacy (миграция: RESOLVED → CLOSED)
  OPEN
  ANSWERED
  CLOSED
}

enum AuditAction {
  COMPANY_CREATE
  COMPANY_DELETE
  COURIER_CREATE
  COURIER_DELETE
  LIMIT_CHANGE
  // Bonus-program protection (PR-C). Every admin bonus action is logged.
  BONUS_FREEZE
  BONUS_UNFREEZE
  BONUS_ADJUSTMENT
  BONUS_APPROVE
  BONUS_REJECT
  SUPPORT_RESOLVE
  // Поддержка 2.0: ответ админа в тред и закрытие диалога.
  SUPPORT_REPLY
  SUPPORT_CLOSE
  // Курьер 2.0 admin: deactivation toggle + privacy-critical CSV export.
  COURIER_DEACTIVATE
  COURIER_ACTIVATE
  COURIER_CSV_EXPORT
  // Account deletion (Поддержка 2.0 волна): анонимизация и hard-delete клиента.
  CLIENT_ANONYMIZE
  CLIENT_HARD_DELETE
  // PR-D: неудачная попытка staff-логина (brute-force видимость).
  LOGIN_FAILED
  // Модуль 6 ТЗ v2: владелец АЗС сменил режим идентификации на колонке. Влияет
  // на счёт, поэтому попадает в журнал.
  STATION_DISPENSER_IDENTIFICATION
}

// Причина клиентской отмены (Этап 1 финального марафона).
enum OrderCancelReason {
  CHANGED_MIND
  ORDERED_BY_MISTAKE
  PRICE
  WAIT_TOO_LONG
  OTHER
}

enum OrderStatus {
  CREATED
  PENDING_APPROVAL
  ASSIGNED
  ON_ROUTE
  DELIVERED
  CLOSED
  REJECTED
  CANCELLED
  RECEIVED           // received by dispatcher (new flow)
  COURIER_ASSIGNED
  IN_DELIVERY
  DISPUTED           // courier amount disputed by driver; frozen, no deduction
  SCHEDULED          // B2C planned order; not dispatched until its window opens
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  lastName      String?
  passwordHash  String?
  phone         String?   @unique
  driverPassword String?
  vehicleNumber String?
  telegramId    String?   @unique
  role          Role
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // M4 Propane: this client's slot bookings.
  propaneBookings PropaneBooking[] @relation("ClientPropaneBookings")

  // v2: АЗС, которыми владеет этот пользователь, и его заправки на них.
  ownedStations   FuelStation[]    @relation("StationOwner")
  fuelingSessions FuelingSession[] @relation("ClientFuelingSessions")

  // M4 Propane: points this operator is assigned to.
  operatedPropanePoints PropanePoint[] @relation("PropanePointOperator")

  // Referrals (M5): a short unique code, and who referred this user.
  referralCode  String?   @unique
  referredById  String?

  // Bonus-program protection (PR-C). When true, BOTH accrual and spending are
  // blocked for this user; the balance stays visible. Toggled by super-admins.
  bonusFrozen   Boolean   @default(false)

  // Courier shifts (Курьер 2.0). Semantically used only for COURIER users:
  // toggled via the bot's "На смене" / "Завершить смену" buttons. Only couriers
  // that are onDuty AND have a fresh live location get offered new orders.
  onDuty        Boolean   @default(false)

  // Account deletion (клиент): anonymized-at. Orders/ledger/referrals stay as
  // financial records; PII is wiped and the client auth path rejects the user.
  deletedAt     DateTime?

  // Courier deactivation (Курьер 2.0 admin). When set, the courier is blocked
  // from authenticating and is excluded from every dispatch path. Nullable —
  // NULL means active. Additive; semantically used only for COURIER users.
  deactivatedAt DateTime?

  // B2C: the client's default vehicle, used to prefill the order flow. Nullable
  // FK to one of their own ClientCars; SET NULL if that car is deleted.
  defaultCarId  String?
  // Этап 2: сохранённый адрес по умолчанию — предвыбор на шаге адреса.
  defaultLocationId String?
  defaultLocation   SavedLocation? @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)

  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverCars    DriverCar[]
  ordersCreated Order[]   @relation("CreatedBy")
  ordersAssigned Order[]  @relation("AssignedTo")
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  // B2C (M2): a CLIENT's saved cars, their orders, and (for couriers) live location.
  clientCars     ClientCar[]      @relation("CarOwner")
  defaultCar     ClientCar?       @relation("UserDefaultCar", fields: [defaultCarId], references: [id], onDelete: SetNull)
  clientOrders   Order[]          @relation("ClientOrders")
  courierLocation CourierLocation?
  // Referrals + bonus + saved locations (M5).
  referredBy     User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]           @relation("Referrals")
  bonusLedger    BonusLedger[]
  savedLocations SavedLocation[]
  supportTickets SupportTicket[]

  @@index([referredById])
}

// One immutable row per bonus-liter movement (M5). Money-adjacent — only the
// server writes here, always inside the order transaction for SPENT/REFUND.
model BonusLedger {
  id        String            @id @default(cuid())
  userId    String
  liters    Int               // always positive; sign implied by `reason`
  reason    BonusReason
  // Only POSTED rows count toward balance + milestone (PR-C). The row's
  // `status` is the ONLY mutable field (approve/reject flips it); liters/reason
  // are never updated and rows are never deleted — corrections are new rows.
  status    BonusLedgerStatus @default(POSTED)
  // Free-text admin note for ADMIN_ADJUSTMENT rows (required at write time).
  adminComment String?
  // Super-admin who created/decided this row, for the audit trail.
  adminId   String?
  orderId   String?
  createdAt DateTime          @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  // PR-C: баланс = агрегация POSTED-строк пользователя — считается на каждом
  // открытии /benzin и кабинета.
  @@index([userId, status])
  @@index([orderId])
  @@index([status])
  @@index([reason, status])
}

// Up to 3 saved delivery addresses per client (M5, limit enforced server-side).
model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Пользователи, выбравшие этот адрес по умолчанию (на практике — владелец).
  defaultOf User[] @relation("UserDefaultLocation")

  @@index([userId])
}

// Client support tickets (Кабинет 2.0, PR-A). One row per submission; rate-limited
// server-side to 3/hour/user. Admin "Обращения" triage lands in a later PR.
model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  type      SupportTicketType
  text      String // legacy: первое сообщение треда (продублировано в SupportMessage)
  status    SupportTicketStatus @default(OPEN)
  // Поддержка 2.0: эскалация — клиент позвал оператора, ИИ замолкает.
  needsHuman Boolean            @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

// Поддержка 2.0: тред переписки внутри обращения.
enum SupportMessageAuthor {
  CLIENT
  ADMIN
  AI
}

model SupportMessage {
  id         String               @id @default(cuid())
  ticketId   String
  authorType SupportMessageAuthor
  text       String
  createdAt  DateTime             @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// B2C client vehicle (M2). Created on the client's first fuel order; reused
// afterwards. Separate from the B2B `Car` model (which has company + limits).
model ClientCar {
  id           String   @id @default(cuid())
  userId       String
  plate        String
  model        String?
  tankCapacity Int?     // liters; enables the "full tank" option when known
  // Кабинет 2.0 (PR-A): richer car profile. All optional.
  brand        String?    // e.g. "Chevrolet"
  color        String?    // free-text colour label
  fuelType     FuelType?  // the car's usual fuel — prefills the order flow
  oilType      String?    // preferred engine-oil grade (free text)
  photoUrl     String?    // Vercel Blob URL of the car photo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation("CarOwner", fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  // Users who picked this car as their default (the "UserDefaultCar" relation,
  // in practice at most the owner). Reverse side of User.defaultCar.
  defaultOf User[] @relation("UserDefaultCar")

  @@index([userId])
}

// Latest known live location of a courier (M2). Fed by the Telegram bot's live
// location share; drives geo-dispatch (nearest couriers) and future tracking.
model CourierLocation {
  id        String   @id @default(cuid())
  courierId String   @unique
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  courier User @relation(fields: [courierId], references: [id], onDelete: Cascade)
  // PR-C: выборка курьеров со свежей геолокацией (updatedAt >= now-15м)
  // на каждом диспатче.
  @@index([updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 6-digit verification codes for signup and password reset (email/SMS)
model VerificationCode {
  id         String   @id @default(cuid())
  identifier String   // email or phone (E.164)
  code       String   // 6-digit plain (short-lived)
  purpose    String   // signup | password_reset
  meta       Json?    // for signup: { fullName, companyName, email, phone, passwordHash }
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  telegram  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  cars      Car[]
  invoices  Invoice[]
}

model Car {
  id           String   @id @default(cuid())
  companyId    String
  plateNumber  String
  model        String?
  fuelType     FuelType
  tankCapacity Int      @default(80) // liters
  monthlyLimit Int      // liters per month
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverCars   DriverCar[]
  orders       Order[]
  usage        CarUsage[]

  @@unique([companyId, plateNumber])
}

model DriverCar {
  id        String   @id @default(cuid())
  driverId  String
  carId     String
  createdAt DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
  car    Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([driverId, carId])
}

model Order {
  id         String      @id @default(cuid())
  // carId is nullable now: B2B orders use `car`, B2C orders use `clientCar`.
  carId      String?
  fuelType   FuelType
  volume     Int         // liters
  dispensedVolume Int?    // actual liters dispensed by courier (fact)
  isFullTank Boolean     @default(false)
  status     OrderStatus @default(CREATED)
  address    String?
  notes      String?
  // Telegram bot confirmation flow: null | AWAIT_CONFIRM | AWAIT_LOCATION
  botPhase   String?
  // Delivery coordinates (driver's Telegram share for B2B; map pin for B2C).
  lat        Float?
  lng        Float?
  createdById String?
  assignedToId String?
  // --- B2C (M2) ---
  clientId      String?
  clientCarId   String?
  pricePerLiter Int?              // UZS per liter, snapshot at order time
  totalAmount   Int?              // UZS = pricePerLiter * volume, snapshot
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus?
  scheduledFor  DateTime?          // B2C: planned delivery time (SCHEDULED orders)
  bonusLitersUsed Int?             // M5: bonus liters applied (reduces totalAmount)
  // Клиентская отмена (финальный марафон, этап 1): причина + комментарий (OTHER).
  cancelReason  OrderCancelReason?
  cancelComment String?
  // Оценка доставки после DELIVERED (этап 2): 1–5 звёзд, один раз.
  rating        Int?
  ratingComment String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // Set when a courier TAKEs the order; paired with deliveredAt to measure the
  // TAKE→DELIVERED duration in /stats. Nullable; only populated going forward.
  takenAt    DateTime?
  deliveredAt DateTime?

  car         Car?  @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdBy   User? @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo  User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  client      User?      @relation("ClientOrders", fields: [clientId], references: [id])
  clientCar   ClientCar? @relation(fields: [clientCarId], references: [id])
  paymeTransactions PaymeTransaction[]
  bonusLedger BonusLedger[]

  @@index([status])
  @@index([createdAt])
  @@index([deliveredAt])
  @@index([carId])
  @@index([carId, status])
  @@index([clientId])
  // PR-C: история клиента (кабинет, карточка клиента, lastOrder) — фильтр по
  // clientId с сортировкой createdAt desc.
  @@index([clientId, createdAt])
  @@index([status, assignedToId])
}

model Price {
  id        String   @id @default(cuid())
  fuelType  FuelType @unique
  priceUzs  Int      // per liter
  updatedAt DateTime @updatedAt
}

// Payme (Paycom) Merchant API transaction (M2 / PR-B). One order can have
// several (e.g. a cancelled attempt then a successful one). State follows the
// Payme spec: 1 created, 2 performed, -1 cancelled(after create), -2 cancelled(after perform).
model PaymeTransaction {
  id          String   @id @default(cuid())
  paycomId    String   @unique // Payme transaction id (params.id)
  orderId     String
  amount      Int              // tiyin (order total × 100)
  state       Int      @default(1)
  reason      Int?
  createTime  BigInt           // Payme ms timestamp
  performTime BigInt?
  cancelTime  BigInt?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createTime])
}

model Invoice {
  id         String   @id @default(cuid())
  companyId  String
  month      Int
  year       Int
  totalUzs   Int
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year])
}

model CarUsage {
  id        String   @id @default(cuid())
  carId     String
  month     Int
  year      Int
  usedLiters Int     @default(0)

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, month, year])
}

// Immutable trail of sensitive super-admin mutations. Never store PII beyond
// the actor email (already known to admins); metadata is sanitized at write.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     AuditAction
  targetType String      // "Company" | "Courier" | "Car" ...
  targetId   String?
  metadata   Json?       // small, non-PII context: { name, before, after, ... }
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// Web Push (PWA notifications). One row per browser/device subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // LOW_LIMIT | FULL_TANK_PENDING | COURIER_ASSIGNED | ORDER_DELIVERED
  title     String
  message   String
  read      Boolean  @default(false)
  orderId   String?
  carId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- M4 Propane (points + slot bookings) ------------------------------------
// Gas trucks stand at fixed points; clients drive up at a booked 15-minute
// slot. Capacity per slot = the point's postsCount (parallel filling posts).

enum PropanePointStatus {
  ACTIVE
  PAUSED
}

enum PropaneBookingStatus {
  BOOKED
  SERVED
  CANCELLED
  NO_SHOW
}

model PropanePoint {
  id         String             @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  status     PropanePointStatus @default(ACTIVE)
  priceUzs   Int // per liter of LPG
  postsCount Int                @default(1) // filling posts = bookings per slot
  // The operator bound to this point. Operators only see and serve their own
  // point's queue; NULL = not assigned yet (only SUPER_ADMIN can serve).
  operatorId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  operator User?            @relation("PropanePointOperator", fields: [operatorId], references: [id])
  bookings PropaneBooking[]

  @@index([operatorId])
}

model PropaneBooking {
  id        String               @id @default(cuid())
  pointId   String
  clientId  String
  slotStart DateTime
  status    PropaneBookingStatus @default(BOOKED)
  code      String               @unique // shown to the operator (number/QR payload)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  point  PropanePoint @relation(fields: [pointId], references: [id])
  client User         @relation("ClientPropaneBookings", fields: [clientId], references: [id])

  // A client can hold at most one booking per point+slot (double-tap guard).
  @@unique([pointId, clientId, slotStart])
  @@index([pointId, slotStart, status])
  @@index([clientId, slotStart])
}

// ============================================================================
// v2 — цифровой контроль топлива на стационарных АЗС
//
// Ядро версии 2 — датчики уровня в резервуарах. Всё остальное (идентификация
// клиента у колонки, налоговая, оплата) наращивается поверх и может быть
// выключено на конкретной АЗС, не ломая остатки на карте.
//
// Модель доставки (Order, Courier, PropanePoint) не тронута: это отдельный
// бизнес с отдельной ценой. Здесь только стационарные АЗС.
// ============================================================================

// Административное состояние АЗС. Онлайн/офлайн — НЕ здесь: это вычисляется
// из lastSeenAt и меняется каждую минуту, ему нечего делать в поле статуса.
enum StationStatus {
  ACTIVE
  PAUSED // владелец приостановил показ в приложении
  ARCHIVED
}

enum TankStatus {
  ACTIVE
  MAINTENANCE // остатки не показываются клиенту
}

enum DispenserStatus {
  ACTIVE
  DISABLED
}

// Способ, которым приложение понимает, что клиент стоит у этой колонки.
// Возрастает по удобству и по цене для АЗС.
enum IdentificationMode {
  MANUAL // клиент сам выбирает колонку в приложении — работает везде, без железа
  BLE    // маячок на колонке, приложение определяет её по силе сигнала
  CAMERA // распознавание номера, ставится за счёт Benzeen по желанию АЗС
}

// Источник показания уровня. Ручной ввод существует ради пилота и сверок и
// всегда отличим от датчика — иначе расхождение невозможно расследовать.
enum TankReadingSource {
  SENSOR
  MANUAL
}

// Жизненный цикл одной заправки. Двухфазная транзакция: сначала резерв под
// полный бак, потом точное списание по факту литров.
enum FuelingStatus {
  RESERVED       // деньги захолдированы, пистолет ещё не вставлен
  FLOWING        // идёт заливка, литры приходят с колонки
  COMPLETED      // заливка кончилась, сумма известна
  SETTLED        // точное списание прошло, разница возвращена
  CANCELLED      // клиент отменил до начала заливки, резерв разморожен
  MANUAL_REVIEW  // связь не вернулась за 30 минут — сверка по логу колонки
  FAILED
}

// Что именно тарифицируется. Датчик обязателен, колонка — опция.
enum StationBillingItem {
  TANK      // 25 000 сум/сутки за резервуар
  DISPENSER // 10 000 сум/сутки за колонку с идентификацией клиента
}

enum StationInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// Стационарная АЗС, подключённая к Benzeen.
model FuelStation {
  id       String        @id @default(cuid())
  name     String
  brand    String?
  address  String
  region   String?
  lat      Float
  lng      Float
  status   StationStatus @default(ACTIVE)

  // Владелец АЗС: видит только свою точку в кабинете.
  ownerId String?

  // ИНН АЗС для фискального чека в Солик. Пока не заполнен — чек уходит без
  // ИНН, поэтому поле необязательное: подключение объекта не должно ждать
  // бумажной части, а Солик принимает чек и без ИНН на этапе пилота.
  tin String?

  // Ключ пограничного контроллера на объекте. Хранится только хеш — по той же
  // причине, по которой не хранятся пароли: утечка дампа не должна давать
  // право писать телеметрию от имени АЗС.
  controllerKeyHash String?
  // Последний признак жизни от контроллера. Онлайн/офлайн считается отсюда.
  lastSeenAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User?                 @relation("StationOwner", fields: [ownerId], references: [id])
  tanks    Tank[]
  dispensers Dispenser[]
  prices   StationPrice[]
  sessions FuelingSession[]
  billing  StationBillingSubscription[]
  invoices StationInvoice[]

  @@index([ownerId])
  @@index([status])
}

// Цена АЗС по виду топлива. Решение владельца: цену ставит сама АЗС в своём
// приложении, к нам она приезжает; цена доставки — отдельная сущность и здесь
// её нет намеренно.
model StationPrice {
  id        String   @id @default(cuid())
  stationId String
  fuelType  FuelType
  priceUzs  Int // за литр
  updatedAt DateTime @updatedAt

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, fuelType])
}

// Резервуар с датчиком уровня. Датчик обязателен — это ядро продукта.
model Tank {
  id        String     @id @default(cuid())
  stationId String
  label     String // как резервуар назван на объекте
  fuelType  FuelType
  capacityL Int
  // Порог, ниже которого остаток считается критическим (алерт в кабинете).
  minLevelL Int?
  status    TankStatus @default(ACTIVE)

  sensorSerial String? @unique

  // Денормализованный последний уровень. Карта страны запрашивается на каждом
  // открытии приложения; считать последнее показание подзапросом по таблице
  // истории на каждый резервуар — это то, что положит карту первым.
  currentLevelL  Float?
  lastReadingAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station  FuelStation                  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  readings TankReading[]
  billing  StationBillingSubscription[]

  @@unique([stationId, label])
  @@index([stationId, fuelType])
}

// История показаний. Append-only: это доказательная база при расхождениях,
// строки не обновляются и не удаляются.
model TankReading {
  id     String @id @default(cuid())
  tankId String

  levelL       Float
  temperatureC Float?
  // Объём, если датчик считает его сам, а не только высоту столба.
  volumeL      Float?

  source TankReadingSource @default(SENSOR)

  // Время на объекте и время получения нами. Расходятся при буферизации на
  // контроллере после потери связи, и по этому расхождению видно офлайн.
  measuredAt DateTime
  receivedAt DateTime @default(now())

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId, measuredAt])
}

// Колонка (ТРК). Идентификация клиента — опция, которая тарифицируется отдельно.
model Dispenser {
  id        String          @id @default(cuid())
  stationId String
  number    Int // номер колонки, как он написан на объекте
  status    DispenserStatus @default(ACTIVE)

  fuelTypes FuelType[]

  identificationMode IdentificationMode @default(MANUAL)
  // Идентификатор BLE-маячка на этой колонке.
  bleBeaconId        String?            @unique

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station  FuelStation                  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sessions FuelingSession[]
  billing  StationBillingSubscription[]

  @@unique([stationId, number])
  @@index([stationId])
}

// Одна заправка на стационарной АЗС.
model FuelingSession {
  id          String @id @default(cuid())
  stationId   String
  dispenserId String
  clientId    String?
  carId       String?

  fuelType FuelType

  // Чего попросил клиент: литры, сумму или полный бак (оба поля пустые).
  requestedLiters    Int?
  requestedAmountUzs Int?

  // Сумма резерва (hold) и цена, по которой резерв считался.
  holdAmountUzs Int
  priceUzs      Int

  // Лимит отпуска, переданный колонке: за него заливка выйти не должна, иначе
  // перелив ляжет на АЗС (см. settle() в lib/fueling.ts).
  limitLiters Float?

  // Факт по завершении заливки.
  litersDispensed Float?
  amountUzs       Int?

  // Возвращённая клиенту разница между резервом и фактом.
  refundUzs Int?

  // Последний тик с колонки. По его давности видно, что заливка кончилась
  // (минута молчания) или что связь с объектом пропала (полчаса).
  lastTickAt DateTime?

  status         FuelingStatus      @default(RESERVED)
  identifiedBy   IdentificationMode @default(MANUAL)

  // Ссылка на транзакцию эквайринга. Платёжных данных карты у нас нет и не
  // будет — только ссылка банка.
  acquirerRef String?

  // Налоговая: когда чек ушёл в Солик и сколько кешбека начислено (1%).
  soliqSyncedAt DateTime?
  cashbackUzs   Int?

  // Заливка, пришедшая из буфера контроллера после восстановления связи.
  offlineBuffered Boolean @default(false)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  station   FuelStation @relation(fields: [stationId], references: [id])
  dispenser Dispenser   @relation(fields: [dispenserId], references: [id])
  client    User?       @relation("ClientFuelingSessions", fields: [clientId], references: [id])

  @@index([stationId, startedAt])
  @@index([clientId, startedAt])
  @@index([status])
}

// Подписка АЗС на инфраструктуру: не комиссия с оборота, а суточная ставка за
// каждый подключённый резервуар и за каждую колонку с идентификацией.
// Строка живёт от подключения до отключения — по ней и считаются сутки в счёте.
model StationBillingSubscription {
  id        String             @id @default(cuid())
  stationId String
  item      StationBillingItem
  tankId      String?
  dispenserId String?

  dailyRateUzs Int
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  station    FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  tank       Tank?       @relation(fields: [tankId], references: [id], onDelete: Cascade)
  dispenser  Dispenser?  @relation(fields: [dispenserId], references: [id], onDelete: Cascade)

  @@index([stationId, endedAt])
  @@index([tankId])
  @@index([dispenserId])
}

// Счёт за месяц. Решение владельца: выставляется один раз в начале месяца, и
// нужна таблица, из которой видно, кто сколько должен.
model StationInvoice {
  id        String @id @default(cuid())
  stationId String

  periodStart DateTime // первое число месяца
  periodEnd   DateTime

  tankDays      Int // сумма суток по всем резервуарам за период
  dispenserDays Int
  amountUzs     Int

  status StationInvoiceStatus @default(DRAFT)

  issuedAt DateTime?
  paidAt   DateTime?
  dueAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // Один счёт на АЗС за период — повторный запуск начисления не должен
  // выставить второй счёт за тот же месяц.
  @@unique([stationId, periodStart])
  @@index([status, dueAt])
}
